{
  "manifest_version": 3,
  "name": "Run with repodock",
  "version": "0.1.0",
  "description": "Adds a \"Run with repodock\" button to GitHub projects, and picks the right file for your computer on release pages.",
  "homepage_url": "https://umutalisoglu.github.io/repodock/",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["fit.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "repodock@umutalisoglu.github.io", "strict_min_version": "109.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
